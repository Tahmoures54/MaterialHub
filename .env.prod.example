# =============================================================================
# MaterialHub — Production Environment Example
# Copy to .env.prod and fill real values. NEVER commit .env.prod
# =============================================================================

FLASK_ENV=production

# Required: at least 32 random bytes (use: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-at-least-32-random-bytes

# PostgreSQL (password comes from Docker secret file, not here)
POSTGRES_DB=materialhub
POSTGRES_USER=materialhub

# Redis-backed rate limiting (required for multi-worker production)
RATELIMIT_STORAGE_URI=redis://redis:6379/0
RATELIMIT_DEFAULT=300 per minute

# Optional: first registration with this email becomes admin
ADMIN_EMAIL=admin@yourcompany.com

# Request size limit (10 MB)
MAX_CONTENT_LENGTH=10485760

# SQLAlchemy connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Logging
LOG_LEVEL=INFO

# Optional OpenTelemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=materialhub

# Cookies / scheme (Nginx terminates TLS)
PREFERRED_URL_SCHEME=https
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
