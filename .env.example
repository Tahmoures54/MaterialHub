# MaterialHub Environment Variables
# Copy this file to .env and fill in the values

# Required - Generate a strong random key (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-very-long-random-string

# Optional - Leave empty to use SQLite for local development
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/materialhub
DATABASE_URL=

# Environment: development | production
FLASK_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: Admin email that will automatically receive is_admin=True on registration
ADMIN_EMAIL=admin@example.com
