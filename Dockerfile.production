FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir gunicorn
COPY . .
RUN useradd --create-home --uid 10001 materialhub && chown -R materialhub:materialhub /app
USER materialhub
EXPOSE 8000
CMD ["gunicorn","--bind","0.0.0.0:8000","--workers","3","--threads","4","--timeout","120","wsgi:app"]
